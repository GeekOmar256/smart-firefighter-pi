; systemd unit for the AI-Based Firefighter Assistance System.
;
; Install on the Raspberry Pi:
;
;   sudo cp deploy/smart-firefighter.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now smart-firefighter
;   systemctl status smart-firefighter
;
; This unit is what makes the "restart" and "update" commands work: the Pi
; restarts the service, and systemd starts it again with the new code.
;
; Adjust User and the paths if you did not clone into /home/pi.

[Unit]
Description=Smart Firefighter Assistance System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart-firefighter-pi

Environment=REPO_DIR=/home/pi/smart-firefighter-pi
Environment=SERVICE_NAME=smart-firefighter
Environment=FIREBASE_CREDENTIALS=/home/pi/.config/smart-firefighter/service-account.json
Environment=FIREBASE_DATABASE_URL=https://water-analysis-2dy4ar-default-rtdb.firebaseio.com
; Give the Pi a stable name so the controller always addresses the same device.
Environment=DEVICE_ID=raspberrypi
; Lower this if the camera drops frames because the I2C bus is slow.
; Run check_camera.py to find the fastest rate that works.
Environment=REFRESH_HZ=8
; Which GPIO pins the sensors are wired to. Comma-separate FLAME_SENSOR_PINS
; if a second flame sensor is added.
Environment=FLAME_SENSOR_PINS=24
Environment=GAS_SENSOR_PIN=23
; Which pin level means "detected". The flame module drives D0 high on a
; flame; the MQ-2 pulls D0 low on gas. Flip one if it reads backwards.
Environment=FLAME_ACTIVE_LOW=0
Environment=GAS_ACTIVE_LOW=1

ExecStart=/home/pi/smart-firefighter-pi/.venv/bin/python3 /home/pi/smart-firefighter-pi/v3_remote.py

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
